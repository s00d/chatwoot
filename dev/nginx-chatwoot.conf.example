# Sample Nginx site for Chatwoot Docker (bind 127.0.0.1:3000).
# Copy to /etc/nginx/sites-available/chatwoot and adjust server_name.
# Then: certbot --nginx -d YOUR_DOMAIN

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

upstream chatwoot_app {
  server 127.0.0.1:3000;
}

server {
  listen 80;
  server_name chat-staging.example.com;

  client_max_body_size 20m;

  # Compress JS/CSS/JSON/SVG from the app: nginx gzips only text/html by default, and the
  # dashboard bundle is several MB uncompressed. gzip_proxied is needed for proxied responses.
  gzip on;
  gzip_proxied any;
  gzip_vary on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_types text/css application/javascript text/javascript application/json image/svg+xml text/plain;

  location / {
    proxy_pass http://chatwoot_app;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 300;
  }

  location /cable {
    proxy_pass http://chatwoot_app;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 86400;
  }
}
