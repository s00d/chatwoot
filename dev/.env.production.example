# Example production .env for Docker (OnlineSIM fork).
# Copy to `.env` on the server — never commit real secrets.
# Full docs: dev/04-github-actions-and-env.md

# --- Core ---
SECRET_KEY_BASE=replace_with_lengthy_secure_hex
RAILS_ENV=production
FRONTEND_URL=https://chat-staging.example.com
FORCE_SSL=true
INSTALLATION_ENV=docker
ENABLE_ACCOUNT_SIGNUP=false

# OnlineSIM hub (optional override)
# CHATWOOT_HUB_URL=https://hub.2.chatwoot.on-mail.ru

# Active Record Encryption (MFA) — generate with: rails db:encryption:init
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace_me
POSTGRES_DATABASE=chatwoot

# --- Redis (OnlineSIM uses DB 5 by default in lib/redis/config.rb) ---
REDIS_PASSWORD=replace_me
REDIS_URL=redis://:replace_me@redis:6379/5
REDIS_DB=5

# --- Mail (fill for real mail) ---
MAILER_SENDER_EMAIL=Chatwoot <noreply@example.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer
SMTP_DOMAIN=example.com

# --- Storage (local disk volumes by default) ---
ACTIVE_STORAGE_SERVICE=local

# --- Runtime ---
RAILS_LOG_TO_STDOUT=true
RAILS_MAX_THREADS=5
# Puma worker processes: one per CPU core (0 = single process, uses at most one core).
# Each worker takes ~500 MB with YJIT. DB connections: WEB_CONCURRENCY * RAILS_MAX_THREADS + SIDEKIQ_CONCURRENCY < 100.
WEB_CONCURRENCY=2
# Ruby JIT: ~1.5x throughput for ~80 MB more memory per process
RUBY_YJIT_ENABLE=1
# Restart the largest Puma worker when all workers together exceed this (MB), cluster mode only
PUMA_WORKER_KILLER_RAM_MB=2048
