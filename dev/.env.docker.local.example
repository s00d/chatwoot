# Local Docker dev (.env for compose — separate from host .env)
# cp dev/.env.docker.local.example .env.docker

SECRET_KEY_BASE=dev_secret_key_base_change_me_in_real_use
FRONTEND_URL=http://127.0.0.1:3041
FORCE_SSL=false
RAILS_ENV=development
ENABLE_ACCOUNT_SIGNUP=true

# Docker service hostnames (not localhost)
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=chatwoot

REDIS_PASSWORD=devredis
REDIS_URL=redis://:devredis@redis:6379

MAILER_SENDER_EMAIL=Chatwoot <accounts@chatwoot.com>
SMTP_ADDRESS=mailhog
SMTP_PORT=1025
# Mailhog UI: http://127.0.0.1:8026
