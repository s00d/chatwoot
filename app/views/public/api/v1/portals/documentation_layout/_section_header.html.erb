<header class="<%= local_assigns[:wrapper_class] || 'mb-4' %>">
  <h2 class="text-lg md:text-xl font-620 tracking-tight text-n-slate-12"><%= title %></h2>
  <% if local_assigns[:subtitle].present? %>
    <p class="<%= local_assigns[:subtitle_class] || 'mt-1 text-sm text-n-slate-11' %>"><%= subtitle %></p>
  <% end %>
</header>
